---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects, projectHref } from '../data/projects';
const allProjects = await getProjects('pt');
const featured = allProjects.find((project) => project.slug === 'smart-clinic-assistant');
const projects = allProjects.filter((project) => project.slug !== featured?.slug);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout locale="pt" active="" title="Início" description="Portfolio de Tiago Santos: experiência em marketing digital, design, operações e atendimento, com aprendizagem em IA, automação e desenvolvimento de software.">
  <section class="container home-hero">
    <div class="home-hero-copy"><p class="eyebrow">Portfolio · Marketing · Design · Tecnologia</p><h1>Ideias digitais, desenhadas com intenção.</h1><p class="home-hero-subtitle">Criatividade e experiência prática a encontrar novas possibilidades na tecnologia.</p><p class="home-hero-description">Experiência em marketing digital, design gráfico aplicado à publicidade, gestão operacional e atendimento. Actualmente, a explorar inteligência artificial, automação e desenvolvimento de software.</p><div class="hero-actions"><a class="button" href={`${base}projects/`}>Explorar projectos</a><a class="button button-secondary" href={`${base}cv/Tiago_Santos_CV_PT.pdf`} download>Descarregar CV</a><a class="text-link" href={`${base}about/`}>Conhecer o meu percurso <span aria-hidden="true">→</span></a></div></div>
    <aside class="home-hero-signature" aria-label="Tiago Santos — Digital e tecnologia"><span class="signature-rule" aria-hidden="true"></span><span class="signature-name">TIAGO SANTOS</span><span class="signature-role">DIGITAL <i aria-hidden="true">—</i> TECNOLOGIA</span></aside>
  </section>
  <section class="home-profile"><div class="container home-profile-grid"><div><p class="eyebrow">Perfil</p><h2>Comunicação, operação e curiosidade tecnológica.</h2></div><div><p>O meu percurso cruza marketing digital, design gráfico aplicado à publicidade, gestão operacional e atendimento. Trago essa experiência para a forma como observo problemas e procuro soluções.</p><p>Estou a desenvolver competências em IA, automação e software, com uma abordagem prática e consciente do que ainda estou a aprender.</p><a class="text-link" href={`${base}about/`}>Mais sobre o meu percurso <span aria-hidden="true">→</span></a></div></div></section>
  <section class="home-projects" id="projects"><div class="container home-projects-inner"><div class="section-heading"><div><p class="eyebrow">Projectos pessoais</p><h2>Aplicações e estudos de caso</h2></div><p>Código inspeccionado, funcionalidades verificáveis e limitações documentadas.</p></div>
    {featured && <article class="home-feature-project"><div class="home-feature-copy"><span class="project-index">DESTAQUE / 01</span><span class="project-kind">{featured.kind}</span><h3>{featured.title}</h3><p>{featured.description}</p><div class="tag-list">{featured.tags.map((tag) => <span class="tag">{tag}</span>)}</div><a class="text-link" aria-label={`Ver estudo de caso: ${featured.title}`} href={featured.caseStudy ? projectHref('pt', featured.slug) : `${base}projects/`}>{featured.caseStudy ? 'Ver estudo de caso' : 'Ver projecto e capturas'} <span aria-hidden="true">→</span></a></div><div class="home-feature-images">{featured.images?.slice(0, 2).map((image) => <a href={`${base}${image.src.replace(/^\/+/, '')}`} target="_blank" rel="noreferrer" aria-label={`Abrir imagem: ${image.alt}`}><img src={`${base}${image.src.replace(/^\/+/, '')}`} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /></a>)}</div></article>}
    <div class="home-project-grid">{projects.map((project, index) => <article class="home-project-card"><span class="project-index">{String(index + 2).padStart(2, '0')}</span><span class="project-kind">{project.kind}</span><h3>{project.title}</h3><p>{project.description}</p><div class="tag-list">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div><span class="home-project-art" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>{project.caseStudy ? <a class="text-link home-case-study-link" aria-label={`Ver estudo de caso: ${project.title}`} href={projectHref('pt', project.slug)}>Ver estudo de caso <span aria-hidden="true">→</span></a> : <a class="card-hit-link" href={`${base}projects/`} aria-label={`Ver ${project.title} na página de projectos`}></a>}</article>)}</div>
    <p class="section-link"><a class="text-link" href={`${base}projects/`}>Ver todos os projectos <span aria-hidden="true">→</span></a></p>
  </div></section>
  <section class="home-areas"><div class="container"><div class="section-heading"><div><p class="eyebrow">Experiência e exploração</p><h2>Áreas que se cruzam</h2></div><p>Uma distinção clara entre o que já faz parte do meu percurso e o que estou a desenvolver.</p></div><div class="home-area-grid"><article class="home-area-card"><span class="project-index">01 / EXPERIÊNCIA</span><h3>Prática profissional</h3><div class="tag-list"><span class="tag">Marketing digital</span><span class="tag">Design gráfico para publicidade</span><span class="tag">Gestão operacional</span><span class="tag">Atendimento</span></div></article><article class="home-area-card home-area-learning"><span class="project-index">02 / EM DESENVOLVIMENTO</span><h3>Aprendizagem e exploração</h3><div class="tag-list"><span class="tag">Inteligência artificial</span><span class="tag">Automação</span><span class="tag">Desenvolvimento Web</span><span class="tag">Software</span></div></article></div></div></section>
  <section class="home-contact"><div class="container home-contact-inner"><div><p class="eyebrow">Próximo passo</p><h2>Explore o trabalho e o percurso.</h2></div><div><p>O portfolio está em desenvolvimento. Consulte os projectos ou a página de contacto para mais informação.</p><div class="hero-actions"><a class="button" href={`${base}projects/`}>Ver projectos</a><a class="text-link" href={`${base}contact/`}>Página de contacto <span aria-hidden="true">→</span></a></div></div></div></section>
</BaseLayout>
