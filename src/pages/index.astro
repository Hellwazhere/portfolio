---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../data/projects';
const projects = (await getProjects('pt')).slice(0, 2);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout locale="pt" active="" title="Início" description="Portfolio de Tiago: experiência em marketing digital, design e operações, com aprendizagem em IA, automação e software.">
  <section class="container hero">
    <p class="eyebrow">Marketing · Design · Tecnologia</p>
    <h1>Experiência digital. Criatividade. Tecnologia.</h1>
    <p class="hero-copy">Combino experiência em marketing digital, design e operações com o desenvolvimento de competências em inteligência artificial, automação e software. Exploro formas de transformar ideias e necessidades reais em soluções digitais.</p>
    <div class="hero-actions"><a class="button" href={`${base}projects/`}>Explorar projectos</a><a class="text-link" href={`${base}about/`}>Conhecer o meu percurso <span aria-hidden="true">→</span></a></div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-heading"><h2>Em exploração</h2><p>Exemplos de conceitos e exercícios. Serão substituídos por projectos reais à medida que forem desenvolvidos.</p></div>
      <div class="project-grid">{projects.map((project) => <article class="project-card"><span class="project-kind">{project.kind}</span><h3>{project.title}</h3><p>{project.description}</p><div class="tag-list">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></article>)}</div>
      <p style="margin-top: 24px"><a class="text-link" href={`${base}projects/`}>Ver todos os exemplos <span aria-hidden="true">→</span></a></p>
    </div>
  </section>
</BaseLayout>
