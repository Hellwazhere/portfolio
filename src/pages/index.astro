---
import '../styles/home.css';
import FeaturedProject from '../components/FeaturedProject.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects, projectHref } from '../data/projects';
const allProjects = await getProjects('pt');
const featured = allProjects.find((project) => project.slug === 'pedro-pires');
const projects = allProjects.filter((project) => project.slug !== featured?.slug);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout locale="pt" active="" title="Início" description="Portfolio de Tiago Santos: seis projectos de desenvolvimento Web, incluindo o website do ilustrador Pedro Pires e cinco aplicações pessoais, com estudos de caso.">
  <section class="container home-hero">
    <div class="home-hero-copy"><p class="eyebrow">Portfolio · Marketing · Design · Tecnologia</p><h1>Desenvolvimento Web e operações digitais, com desenvolvimento de software assistido por IA.</h1><p class="home-hero-subtitle">Seis projectos: um website profissional e cinco aplicações pessoais, com código e estudos de caso.</p><p class="home-hero-description">Experiência profissional em marketing digital, design gráfico, operações, atendimento e gestão de websites. Os projectos pessoais demonstram HTML, CSS, JavaScript, TypeScript, testes e publicação web.</p><div class="hero-actions"><a class="button" href={`${base}projects/`}>Explorar projectos</a><a class="button button-secondary" href={`${base}cv/Tiago_Santos_CV_PT.pdf`} download>Descarregar CV</a><a class="text-link" href={`${base}about/`}>Conhecer o meu percurso <span aria-hidden="true">→</span></a></div></div>
    <aside class="home-hero-signature" aria-label="Tiago Santos — Digital e tecnologia"><span class="signature-rule" aria-hidden="true"></span><span class="signature-name">TIAGO SANTOS</span><span class="signature-role">DIGITAL <i aria-hidden="true">—</i> TECNOLOGIA</span></aside>
  </section>
  <section class="home-profile"><div class="container home-profile-grid"><div><p class="eyebrow">Perfil</p><h2>Experiência profissional aplicada a ferramentas digitais.</h2></div><div><p>O meu percurso em comunicação e operações orienta a forma como organizo informação, desenho interfaces e abordo fluxos de trabalho digitais.</p><p>Os projectos demonstram desenvolvimento Web, validação, testes e gestão local de dados. O desenvolvimento assistido por IA distingue-se da integração de IA numa aplicação: o Pauta usa modelos determinísticos, sem IA generativa.</p><a class="text-link" href={`${base}about/`}>Mais sobre o meu percurso <span aria-hidden="true">→</span></a></div></div></section>
  <section class="home-projects" id="projects"><div class="container home-projects-inner"><div class="section-heading"><div><p class="eyebrow">Projectos</p><h2>Websites, aplicações e estudos de caso</h2></div><p>Código inspeccionado, funcionalidades verificáveis e limitações documentadas.</p></div>
    {featured && <FeaturedProject project={featured} locale="pt" />}
    <div class="home-project-grid">{projects.map((project, index) => <article class="home-project-card"><span class="project-index">{String(index + 2).padStart(2, '0')}</span><span class="project-kind">{project.kind}</span><h3>{project.title}</h3><p>{project.description}</p><div class="tag-list">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div><span class="home-project-art" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>{project.caseStudy ? <a class="text-link home-case-study-link" aria-label={`Ver estudo de caso: ${project.title}`} href={projectHref('pt', project.slug)}>Ver estudo de caso <span aria-hidden="true">→</span></a> : <a class="card-hit-link" href={`${base}projects/`} aria-label={`Ver ${project.title} na página de projectos`}></a>}</article>)}</div>
    <p class="section-link"><a class="text-link" href={`${base}projects/`}>Ver todos os projectos <span aria-hidden="true">→</span></a></p>
  </div></section>
  <section class="home-areas"><div class="container"><div class="section-heading"><div><p class="eyebrow">Experiência e interesses profissionais</p><h2>Áreas que se cruzam</h2></div><p>Experiência profissional, competências demonstradas em projectos pessoais e áreas de desenvolvimento.</p></div><div class="home-area-grid"><article class="home-area-card"><span class="project-index">01 / EXPERIÊNCIA</span><h3>Prática profissional</h3><div class="tag-list"><span class="tag">Marketing digital</span><span class="tag">Design gráfico para publicidade</span><span class="tag">Gestão operacional</span><span class="tag">Atendimento</span></div></article><article class="home-area-card home-area-learning"><span class="project-index">02 / INTERESSES PROFISSIONAIS</span><h3>Áreas de interesse</h3><div class="tag-list"><span class="tag">AI Automation &amp; Digital Operations</span><span class="tag">Web Development</span><span class="tag">AI-assisted Software Development</span></div></article></div></div></section>
  <section class="home-contact"><div class="container home-contact-inner"><div><p class="eyebrow">Próximo passo</p><h2>Explore o trabalho e o percurso.</h2></div><div><p>Explore as demonstrações, o código e as decisões técnicas nos estudos de caso, ou entre em contacto para falar sobre oportunidades profissionais.</p><div class="hero-actions"><a class="button" href={`${base}projects/`}>Ver projectos</a><a class="text-link" href={`${base}contact/`}>Página de contacto <span aria-hidden="true">→</span></a></div></div></div></section>
</BaseLayout>

<style>
@media (min-width: 601px) { .home-project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 600px) { .home-project-grid { grid-template-columns: 1fr; } }
</style>
