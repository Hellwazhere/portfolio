---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, projectHref } from '../../data/projects';
const projects = await getProjects('pt');
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout locale="pt" active="projects" title="Projectos" description="Seis projectos de desenvolvimento Web: o website de Pedro Pires e cinco aplicações pessoais, com estudos de caso e código.">
  <section class="container page-heading projects-heading"><p class="eyebrow">Projectos</p><h1>Projectos e estudos de caso</h1><p class="page-intro">Um website profissional para Pedro Pires e cinco aplicações pessoais. Cada estudo apresenta a implementação, a autoria e os limites do projecto.</p></section>
  <section class="container projects-section" aria-label="Lista de projectos"><div class="project-grid project-grid-wide">{projects.map((project, index) => <article class:list={['project-card', 'project-card-rich', project.images?.length ? 'project-card-featured' : 'project-card-concept']}>
    <div class="project-card-copy"><span class="project-index">{String(index + 1).padStart(2, '0')}</span><span class="project-kind">{project.kind}</span><h2>{project.title}</h2><p>{project.description}</p><div class="tag-list">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>{project.caseStudy && <a class="text-link case-study-link" aria-label={`Ver estudo de caso: ${project.title}`} href={projectHref('pt', project.slug)}>Ver estudo de caso <span aria-hidden="true">→</span></a>}</div>
    {project.images?.length && <div class:list={['project-gallery', project.slug === 'myjobs' && 'project-gallery-myjobs', project.slug === 'smart-clinic-assistant' && 'project-gallery-smart']}>{(['smart-clinic-assistant', 'myjobs', 'pedro-pires'].includes(project.slug) ? project.images.slice(0, 2) : project.images).map((image) => <a class="project-image-link" href={`${base}${image.src.replace(/^\/+/, '')}`} target="_blank" rel="noreferrer" aria-label={`Abrir imagem: ${image.alt}`}><img src={`${base}${image.src.replace(/^\/+/, '')}`} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /></a>)}</div>}
  </article>)}</div></section>
</BaseLayout>
