---
import '../../styles/home.css';
import FeaturedProject from '../../components/FeaturedProject.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, projectHref } from '../../data/projects';
const allProjects = await getProjects('en');
const featured = allProjects.find((project) => project.slug === 'pedro-pires');
const projects = allProjects.filter((project) => project.slug !== featured?.slug);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout locale="en" active="" title="Home" description="Tiago Santos's portfolio: six web development projects, including illustrator Pedro Pires’s website and five personal applications, with case studies.">
  <section class="container home-hero">
    <div class="home-hero-copy"><p class="eyebrow">TECHNOLOGY · DESIGN · AUTOMATION</p><h1>I turn ideas into digital solutions.</h1><p class="home-hero-description">I combine experience in digital marketing, design and operations with AI-assisted web development, creating websites and practical tools for real needs.</p><div class="hero-actions"><a class="button" href={`${base}en/projects/`}>Explore projects</a><a class="button button-secondary" href={`${base}cv/Tiago_Santos_CV_EN.pdf`} download>Download CV</a><a class="text-link" href={`${base}en/about/`}>Read about my background <span aria-hidden="true">→</span></a></div></div>
    <aside class="home-hero-signature" aria-label="Tiago Santos — Digital and technology"><span class="signature-rule" aria-hidden="true"></span><span class="signature-name">TIAGO SANTOS</span><span class="signature-role">DIGITAL <i aria-hidden="true">—</i> TECHNOLOGY</span></aside>
  </section>
  <section class="home-profile"><div class="container home-profile-grid"><div><p class="eyebrow">Profile</p><h2>Experience, practice and learning.</h2></div><div><p>My professional experience in digital marketing, design and operations informs how I organise information and design digital solutions.</p><p>My personal projects demonstrate web development skills and provide an opportunity to explore and learn about automation and AI.</p><a class="text-link" href={`${base}en/about/`}>More about my background <span aria-hidden="true">→</span></a></div></div></section>
  <section class="home-projects" id="projects"><div class="container home-projects-inner"><div class="section-heading"><div><p class="eyebrow">Projects</p><h2>Websites, applications and case studies</h2></div><p>Inspected code, verifiable features and documented limitations.</p></div>
    {featured && <FeaturedProject project={featured} locale="en" />}
    <div class="home-project-grid">{projects.map((project, index) => <article class="home-project-card">{project.images?.[0] && <div class="home-project-image"><img src={base + project.images[0].src.replace(/^\/images\/projects\//, 'images/projects/thumbnails/').replace(/\.(jpg|webp)$/, '.webp')} alt={project.images[0].alt} width={1200} height={525} loading="lazy" decoding="async" /></div>}<span class="project-index">{String(index + 2).padStart(2, '0')}</span><span class="project-kind">{project.kind}</span><h3>{project.title}</h3><p>{project.description}</p><div class="tag-list">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div><span class="home-project-art" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>{project.caseStudy ? <a class="text-link home-case-study-link" aria-label={`Read case study: ${project.title}`} href={projectHref('en', project.slug)}>Read case study <span aria-hidden="true">→</span></a> : <a class="card-hit-link" href={`${base}en/projects/`} aria-label={`View ${project.title} on the projects page`}></a>}<div class="home-project-external">{project.demoUrl && <a class="text-link" href={project.demoUrl} target="_blank" rel="noopener noreferrer" aria-label={`View demo: ${project.title}`}>View demo <span aria-hidden="true">↗</span></a>}{project.sourceUrl && <a class="text-link" href={project.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`GitHub: ${project.title}`}>GitHub <span aria-hidden="true">↗</span></a>}</div></article>)}</div>
    <p class="section-link"><a class="text-link" href={`${base}en/projects/`}>View all projects <span aria-hidden="true">→</span></a></p>
  </div></section>
  <section class="home-areas"><div class="container"><div class="section-heading"><div><p class="eyebrow">Experience and career interests</p><h2>Areas that connect</h2></div><p>Professional experience, skills demonstrated through personal projects and areas for further development.</p></div><div class="home-area-grid"><article class="home-area-card"><span class="project-index">01 / EXPERIENCE</span><h3>Professional practice</h3><div class="tag-list"><span class="tag">Digital marketing</span><span class="tag">Graphic design for advertising</span><span class="tag">Operational management</span><span class="tag">Customer service</span></div></article><article class="home-area-card home-area-learning"><span class="project-index">02 / CAREER INTERESTS</span><h3>Areas of interest</h3><div class="tag-list"><span class="tag">AI Automation &amp; Digital Operations</span><span class="tag">Web Development</span><span class="tag">AI-assisted Software Development</span></div></article></div></div></section>
  <section class="home-contact"><div class="container home-contact-inner"><div><p class="eyebrow">Next step</p><h2>Open to professional opportunities.</h2></div><div><p>I am open to discussing professional opportunities where I can contribute my experience in marketing, design and operations alongside my digital skills.</p><div class="hero-actions"><a class="button" href={`${base}en/projects/`}>View projects</a><a class="text-link" href={`${base}en/contact/`}>Contact page <span aria-hidden="true">→</span></a></div></div></div></section>
</BaseLayout>

<style>
@media (min-width: 601px) { .home-project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 600px) { .home-project-grid { grid-template-columns: 1fr; } }
</style>
