---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../data/projects';
const projects = (await getProjects('en')).slice(0, 2);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout locale="en" active="" title="Home" description="Tiago Santos's portfolio: experience in digital marketing, design and operations, developing skills in AI, automation and software.">
  <section class="container hero"><p class="eyebrow">Marketing · Design · Technology</p><h1>Digital experience. Creativity. Technology.</h1><p class="hero-copy">I bring together experience in digital marketing, design and business operations with developing skills in artificial intelligence, automation and software. I explore ways to turn ideas and real needs into digital solutions.</p><div class="hero-actions"><a class="button" href={`${base}en/projects/`}>Explore projects</a><a class="text-link" href={`${base}en/about/`}>Read about my background <span aria-hidden="true">→</span></a></div></section>
  <section class="section"><div class="container"><div class="section-heading"><h2>Currently exploring</h2><p>Demonstration concepts and learning exercises. These will be replaced with real work as it is developed.</p></div><div class="project-grid">{projects.map((project) => <article class="project-card"><span class="project-kind">{project.kind}</span><h3>{project.title}</h3><p>{project.description}</p><div class="tag-list">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></article>)}</div><p style="margin-top: 24px"><a class="text-link" href={`${base}en/projects/`}>View all examples <span aria-hidden="true">→</span></a></p></div></section>
</BaseLayout>
