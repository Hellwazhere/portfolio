---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, projectHref } from '../../data/projects';
const allProjects = await getProjects('en');
const featured = allProjects.find((project) => project.slug === 'smart-clinic-assistant');
const projects = allProjects.filter((project) => project.slug !== featured?.slug);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout locale="en" active="" title="Home" description="Tiago Santos's portfolio: experience in digital marketing, graphic design, operations and customer service, with ongoing learning in AI, automation and software development.">
  <section class="container home-hero">
    <div class="home-hero-copy"><p class="eyebrow">Portfolio · Marketing · Design · Technology</p><h1>Digital ideas, shaped with intent.</h1><p class="home-hero-subtitle">Creative thinking and practical experience meeting new possibilities in technology.</p><p class="home-hero-description">Experience in digital marketing, graphic design for advertising, operational management and customer service. Currently exploring artificial intelligence, automation and software development.</p><div class="hero-actions"><a class="button" href={`${base}en/projects/`}>Explore projects</a><a class="button button-secondary" href={`${base}cv/Tiago_Santos_CV_EN.pdf`} download>Download CV</a><a class="text-link" href={`${base}en/about/`}>Read about my background <span aria-hidden="true">→</span></a></div></div>
    <aside class="home-hero-signature" aria-label="Tiago Santos — Digital and technology"><span class="signature-rule" aria-hidden="true"></span><span class="signature-name">TIAGO SANTOS</span><span class="signature-role">DIGITAL <i aria-hidden="true">—</i> TECHNOLOGY</span></aside>
  </section>
  <section class="home-profile"><div class="container home-profile-grid"><div><p class="eyebrow">Profile</p><h2>Communication, operations and technological curiosity.</h2></div><div><p>My background brings together digital marketing, graphic design for advertising, operational management and customer service. I bring that experience to how I look at problems and search for solutions.</p><p>I am developing skills in AI, automation and software through a practical approach that stays clear about what I am still learning.</p><a class="text-link" href={`${base}en/about/`}>More about my background <span aria-hidden="true">→</span></a></div></div></section>
  <section class="home-projects" id="projects"><div class="container home-projects-inner"><div class="section-heading"><div><p class="eyebrow">Personal projects</p><h2>Applications and case studies</h2></div><p>Inspected code, verifiable features and documented limitations.</p></div>
    {featured && <article class="home-feature-project"><div class="home-feature-copy"><span class="project-index">FEATURED / 01</span><span class="project-kind">{featured.kind}</span><h3>{featured.title}</h3><p>{featured.description}</p><div class="tag-list">{featured.tags.map((tag) => <span class="tag">{tag}</span>)}</div><a class="text-link" aria-label={`Read case study: ${featured.title}`} href={featured.caseStudy ? projectHref('en', featured.slug) : `${base}en/projects/`}>{featured.caseStudy ? 'Read case study' : 'View project and screenshots'} <span aria-hidden="true">→</span></a></div><div class="home-feature-images">{featured.images?.map((image) => <a href={`${base}${image.src.replace(/^\/+/, '')}`} target="_blank" rel="noreferrer" aria-label={`Open image: ${image.alt}`}><img src={`${base}${image.src.replace(/^\/+/, '')}`} alt={image.alt} loading="lazy" decoding="async" /></a>)}</div></article>}
    <div class="home-project-grid">{projects.map((project, index) => <article class="home-project-card"><span class="project-index">{String(index + 2).padStart(2, '0')}</span><span class="project-kind">{project.kind}</span><h3>{project.title}</h3><p>{project.description}</p><div class="tag-list">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div><span class="home-project-art" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>{project.caseStudy ? <a class="text-link home-case-study-link" aria-label={`Read case study: ${project.title}`} href={projectHref('en', project.slug)}>Read case study <span aria-hidden="true">→</span></a> : <a class="card-hit-link" href={`${base}en/projects/`} aria-label={`View ${project.title} on the projects page`}></a>}</article>)}</div>
    <p class="section-link"><a class="text-link" href={`${base}en/projects/`}>View all projects <span aria-hidden="true">→</span></a></p>
  </div></section>
  <section class="home-areas"><div class="container"><div class="section-heading"><div><p class="eyebrow">Experience and exploration</p><h2>Areas that connect</h2></div><p>A clear distinction between what is part of my professional background and what I am developing.</p></div><div class="home-area-grid"><article class="home-area-card"><span class="project-index">01 / EXPERIENCE</span><h3>Professional practice</h3><div class="tag-list"><span class="tag">Digital marketing</span><span class="tag">Graphic design for advertising</span><span class="tag">Operational management</span><span class="tag">Customer service</span></div></article><article class="home-area-card home-area-learning"><span class="project-index">02 / IN DEVELOPMENT</span><h3>Learning and exploration</h3><div class="tag-list"><span class="tag">Artificial intelligence</span><span class="tag">Automation</span><span class="tag">Web development</span><span class="tag">Software</span></div></article></div></div></section>
  <section class="home-contact"><div class="container home-contact-inner"><div><p class="eyebrow">Next step</p><h2>Explore the work and background.</h2></div><div><p>This portfolio is a work in progress. Browse the projects or visit the contact page for more information.</p><div class="hero-actions"><a class="button" href={`${base}en/projects/`}>View projects</a><a class="text-link" href={`${base}en/contact/`}>Contact page <span aria-hidden="true">→</span></a></div></div></div></section>
</BaseLayout>
