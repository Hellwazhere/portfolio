---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects, projectHref } from '../../data/projects';
const allProjects = await getProjects('en');
const featured = allProjects.find((project) => project.slug === 'smart-clinic-assistant');
const projects = allProjects.filter((project) => project.slug !== featured?.slug);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout locale="en" active="" title="Home" description="Tiago Santos's portfolio: experience in digital marketing, graphic design, operations and customer service, with web development and AI-assisted software development demonstrated through personal projects.">
  <section class="container home-hero">
    <div class="home-hero-copy" style="min-width: 0;"><p class="eyebrow">Portfolio · Marketing · Design · Technology</p><h1 style="font-size: clamp(32px, 4.5vw, 64px); line-height: 1.12; overflow-wrap: anywhere;">Web development and digital operations, with AI-assisted software development.</h1><p class="home-hero-subtitle">Four functional personal projects, with public demos, source code and case studies.</p><p class="home-hero-description">Professional experience in digital marketing, graphic design, operations, customer service and website management. Personal projects demonstrate HTML, CSS, JavaScript, TypeScript, testing and web deployment.</p><div class="hero-actions"><a class="button" href={`${base}en/projects/`}>Explore projects</a><a class="button button-secondary" href={`${base}cv/Tiago_Santos_CV_EN.pdf`} download>Download CV</a><a class="text-link" href={`${base}en/about/`}>Read about my background <span aria-hidden="true">→</span></a></div></div>
    <aside class="home-hero-signature" aria-label="Tiago Santos — Digital and technology"><span class="signature-rule" aria-hidden="true"></span><span class="signature-name">TIAGO SANTOS</span><span class="signature-role">DIGITAL <i aria-hidden="true">—</i> TECHNOLOGY</span></aside>
  </section>
  <section class="home-profile"><div class="container home-profile-grid"><div><p class="eyebrow">Profile</p><h2>Professional experience applied to digital tools.</h2></div><div><p>My background in communication and operations informs how I structure information, design interfaces and approach digital workflows.</p><p>The projects demonstrate web development, validation, testing and local data management. AI-assisted development is distinct from integrating AI into an application: Pauta uses deterministic templates, without generative AI.</p><a class="text-link" href={`${base}en/about/`}>More about my background <span aria-hidden="true">→</span></a></div></div></section>
  <section class="home-projects" id="projects"><div class="container home-projects-inner"><div class="section-heading"><div><p class="eyebrow">Personal projects</p><h2>Applications and case studies</h2></div><p>Inspected code, verifiable features and documented limitations.</p></div>
    {featured && <article class="home-feature-project"><div class="home-feature-copy"><span class="project-index">FEATURED / 01</span><span class="project-kind">{featured.kind}</span><h3>{featured.title}</h3><p>{featured.description}</p><div class="tag-list">{featured.tags.map((tag) => <span class="tag">{tag}</span>)}</div><a class="text-link" aria-label={`Read case study: ${featured.title}`} href={featured.caseStudy ? projectHref('en', featured.slug) : `${base}en/projects/`}>{featured.caseStudy ? 'Read case study' : 'View project and screenshots'} <span aria-hidden="true">→</span></a></div><div class="home-feature-images">{featured.images?.slice(0, 2).map((image) => <a href={`${base}${image.src.replace(/^\/+/, '')}`} target="_blank" rel="noreferrer" aria-label={`Open image: ${image.alt}`}><img src={`${base}${image.src.replace(/^\/+/, '')}`} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /></a>)}</div></article>}
    <div class="home-project-grid">{projects.map((project, index) => <article class="home-project-card"><span class="project-index">{String(index + 2).padStart(2, '0')}</span><span class="project-kind">{project.kind}</span><h3>{project.title}</h3><p>{project.description}</p><div class="tag-list">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div><span class="home-project-art" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>{project.caseStudy ? <a class="text-link home-case-study-link" aria-label={`Read case study: ${project.title}`} href={projectHref('en', project.slug)}>Read case study <span aria-hidden="true">→</span></a> : <a class="card-hit-link" href={`${base}en/projects/`} aria-label={`View ${project.title} on the projects page`}></a>}</article>)}</div>
    <p class="section-link"><a class="text-link" href={`${base}en/projects/`}>View all projects <span aria-hidden="true">→</span></a></p>
  </div></section>
  <section class="home-areas"><div class="container"><div class="section-heading"><div><p class="eyebrow">Experience and career interests</p><h2>Areas that connect</h2></div><p>Professional experience, skills demonstrated through personal projects and areas for further development.</p></div><div class="home-area-grid"><article class="home-area-card"><span class="project-index">01 / EXPERIENCE</span><h3>Professional practice</h3><div class="tag-list"><span class="tag">Digital marketing</span><span class="tag">Graphic design for advertising</span><span class="tag">Operational management</span><span class="tag">Customer service</span></div></article><article class="home-area-card home-area-learning"><span class="project-index">02 / CAREER INTERESTS</span><h3>Areas of interest</h3><div class="tag-list"><span class="tag">AI Automation &amp; Digital Operations</span><span class="tag">Web Development</span><span class="tag">AI-assisted Software Development</span></div></article></div></div></section>
  <section class="home-contact"><div class="container home-contact-inner"><div><p class="eyebrow">Next step</p><h2>Explore the work and background.</h2></div><div><p>Explore the demos, source code and technical decisions in the case studies, or get in touch to discuss professional opportunities.</p><div class="hero-actions"><a class="button" href={`${base}en/projects/`}>View projects</a><a class="text-link" href={`${base}en/contact/`}>Contact page <span aria-hidden="true">→</span></a></div></div></div></section>
</BaseLayout>
