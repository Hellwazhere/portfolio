---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout locale="en" active="contact" title="Contact" description="Contact Tiago Santos to discuss professional opportunities, technology, marketing and digital projects.">
  <section class="container page-heading editorial-heading"><p class="eyebrow">Contact</p><h1>Let's talk.</h1><p class="page-intro">I am open to discussing professional opportunities and collaboration on digital projects.</p></section>
  <section class="container contact-layout" aria-label="Contact information">
    <article class="contact-feature"><span class="project-index">01 / PROFESSIONAL CONVERSATION</span><h2>Digital ideas, technology and collaboration.</h2><p>I bring experience in marketing, design and operations, with an interest in technology and automation.</p></article>
    <aside class="contact-detail"><span class="project-index">02 / CONTACTS</span><h2>Let's stay in touch.</h2><p>For professional conversations, you can reach me through these channels:</p><div class="contact-links"><a href="mailto:tapssantos@gmail.com" target="_blank" rel="noopener noreferrer"><span class="contact-link-type">EMAIL</span><span class="contact-link-value">tapssantos@gmail.com</span><span class="contact-link-arrow" aria-hidden="true">↗</span></a><a href="https://github.com/tiagoapsantos" target="_blank" rel="noopener noreferrer"><span class="contact-link-type">GITHUB</span><span class="contact-link-value">tiagoapsantos</span><span class="contact-link-arrow" aria-hidden="true">↗</span></a><a href="https://www.linkedin.com/in/tiago-ap-santos/" target="_blank" rel="noopener noreferrer"><span class="contact-link-type">LINKEDIN</span><span class="contact-link-value">Tiago Santos</span><span class="contact-link-arrow" aria-hidden="true">↗</span></a></div></aside>
  </section>
  <section class="container contact-next"><p class="eyebrow">In the meantime</p><p>Read about my <a class="text-link" href="../about/">background</a> or explore the <a class="text-link" href="../projects/">projects in progress</a>. <a class="text-link" href={`${base}cv/Tiago_Santos_CV_EN.pdf`} download>Download CV</a>.</p></section>
</BaseLayout>
