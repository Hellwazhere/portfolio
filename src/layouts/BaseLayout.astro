---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description: string; locale: 'pt' | 'en'; active?: string; alternateHref?: string; }
const { title, description, locale, active, alternateHref } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const baseRoot = base.slice(0, -1);
const pathname = Astro.url.pathname;
const routePath = pathname === baseRoot || pathname === base
  ? ''
  : pathname.startsWith(`${baseRoot}/`)
    ? pathname.slice(baseRoot.length + 1).replace(/^\/+/, '')
    : pathname.replace(/^\/+/, '');
const translatedPath = alternateHref ?? (locale === 'en' ? base + routePath.replace(/^en\//, '') : base + 'en/' + routePath);
const translatedUrl = Astro.site ? new URL(translatedPath, Astro.site) : undefined;
const canonical = Astro.site ? new URL(`${base}${routePath}`, Astro.site) : undefined;
---
<!doctype html>
<html lang={locale === 'pt' ? 'pt-PT' : 'en'} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f2eb" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const savedTheme = localStorage.getItem('portfolio-theme');
          root.dataset.theme = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : 'dark';
        } catch {
          root.dataset.theme = 'dark';
        }
      })();
    </script>
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && translatedUrl && <><link rel="alternate" hreflang={locale === 'pt' ? 'pt-PT' : 'en'} href={canonical} /><link rel="alternate" hreflang={locale === 'pt' ? 'en' : 'pt-PT'} href={translatedUrl} /></>}
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}favicon-192.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}favicon-512.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}favicon-180.png`} />
    <title>{title} · Tiago Santos</title>
  </head>
  <body>
    <SiteHeader locale={locale} active={active} alternateHref={alternateHref} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter locale={locale} />
  </body>
</html>
