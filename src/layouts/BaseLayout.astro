---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description: string; locale: 'pt' | 'en'; active?: string; }
const { title, description, locale, active } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const baseRoot = base.slice(0, -1);
const pathname = Astro.url.pathname;
const routePath = pathname === baseRoot || pathname === base
  ? ''
  : pathname.startsWith(`${baseRoot}/`)
    ? pathname.slice(baseRoot.length + 1).replace(/^\/+/, '')
    : pathname.replace(/^\/+/, '');
const canonical = Astro.site ? new URL(`${base}${routePath}`, Astro.site) : undefined;
---
<!doctype html>
<html lang={locale === 'pt' ? 'pt-PT' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfbfa" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} · Tiago</title>
  </head>
  <body>
    <SiteHeader locale={locale} active={active} />
    <main id="main"><slot /></main>
    <SiteFooter locale={locale} />
  </body>
</html>
