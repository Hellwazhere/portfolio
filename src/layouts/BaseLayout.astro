---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description: string; locale: 'pt' | 'en'; active?: string; alternateHref?: string; }
const { title, description, locale, active, alternateHref } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const baseRoot = base.slice(0, -1);
const pathname = Astro.url.pathname;
const routePath = pathname === baseRoot || pathname === base
  ? ''
  : pathname.startsWith(`${baseRoot}/`)
    ? pathname.slice(baseRoot.length + 1).replace(/^\/+/, '')
    : pathname.replace(/^\/+/, '');
const canonical = Astro.site ? new URL(`${base}${routePath}`, Astro.site) : undefined;
---
<!doctype html>
<html lang={locale === 'pt' ? 'pt-PT' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f2eb" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const savedTheme = localStorage.getItem('portfolio-theme');
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          root.dataset.theme = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : (systemDark ? 'dark' : 'light');
        } catch {
          root.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
      })();
    </script>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} · Tiago Santos</title>
  </head>
  <body>
    <SiteHeader locale={locale} active={active} alternateHref={alternateHref} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter locale={locale} />
  </body>
</html>
