---
import { getProjects, projectHref, type Locale } from '../data/projects';
interface Props { project: Awaited<ReturnType<typeof getProjects>>[number]; locale: Locale; }
const { project, locale } = Astro.props;
const en = locale === 'en';
const image = project.images?.[0];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = projectHref(locale, project.slug);
---
<article class="featured-artist">
  <div class="featured-artist-body">
    <div><span class="project-index">{en ? 'FEATURED / 01' : 'DESTAQUE / 01'}</span><p class="project-kind">{project.kind}</p><h3>{project.title}</h3></div>
    <div><p>{project.description}</p><div class="tag-list">{project.tags.map(tag => <span class="tag">{tag}</span>)}</div><div class="featured-artist-links"><a class="text-link" href={href}>{en ? 'Read case study' : 'Ver estudo de caso'} →</a><a class="text-link" href={project.demoUrl} target="_blank" rel="noopener noreferrer">{en ? 'Visit website' : 'Visitar website'} ↗</a><a class="text-link" href={project.sourceUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></div>
  </div>
  {image && <a class="featured-artist-image" href={href} aria-label={en ? 'Read the Pedro Pires case study' : 'Ver o estudo de caso Pedro Pires'}><img src={base + image.src.replace(/^\/+/, '')} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" /></a>}
</article>
<style>
.featured-artist { display:grid; grid-template-columns:minmax(0, .45fr) minmax(0, .55fr); align-items:center; gap:clamp(24px, 3vw, 44px); margin-bottom:24px; padding-block:24px; border-block:1px solid var(--line); }
.featured-artist-image { display:block; min-width:0; }
.featured-artist-image img { display:block; width:100%; height:auto; }
.featured-artist-body { min-width:0; }
h3 { font:600 clamp(26px, 2.3vw, 34px)/1.12 var(--display); letter-spacing:-.045em; margin:12px 0 18px; overflow-wrap:anywhere; }
p { margin:0 0 18px; }
.featured-artist-body > div:last-child > p { max-width:60ch; color:var(--muted); font-size:15px; line-height:1.7; }
.featured-artist-links a { display:inline-flex; align-items:center; min-height:44px; }
.project-kind { margin:12px 0 0; }
.featured-artist-links { display:flex; flex-wrap:wrap; gap:12px 22px; margin-top:20px; }
@media (min-width:701px) and (max-width:900px) {
  .featured-artist { gap:24px; padding-block:24px; }
  h3 { font-size:28px; }
  .featured-artist-links { gap:10px 18px; }
}
@media(max-width:700px) {
  .featured-artist { grid-template-columns:minmax(0, 1fr); gap:24px; padding-block:24px; }
}
</style>
