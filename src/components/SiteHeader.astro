---
interface Props { locale: 'pt' | 'en'; active?: string; }
const { locale, active = '' } = Astro.props;
const isEnglish = locale === 'en';
const labels = isEnglish
  ? { home: 'Home', projects: 'Projects', about: 'About', contact: 'Contact' }
  : { home: 'Início', projects: 'Projectos', about: 'Sobre', contact: 'Contacto' };
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const route = (path = '') => `${base}${isEnglish ? 'en/' : ''}${path ? `${path}/` : ''}`;
const languageHref = isEnglish ? `${base}${active ? `${active}/` : ''}` : `${base}en/${active ? `${active}/` : ''}`;
---
<a class="skip-link" href="#main">{isEnglish ? 'Skip to content' : 'Saltar para o conteúdo'}</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href={route()}>Tiago · Portfolio</a>
    <div class="nav-wrap">
      <nav class="primary-nav" aria-label={isEnglish ? 'Main navigation' : 'Navegação principal'}>
        <a href={route()} aria-current={active === '' ? 'page' : undefined}>{labels.home}</a>
        <a href={route('projects')} aria-current={active === 'projects' ? 'page' : undefined}>{labels.projects}</a>
        <a href={route('about')} aria-current={active === 'about' ? 'page' : undefined}>{labels.about}</a>
        <a href={route('contact')} aria-current={active === 'contact' ? 'page' : undefined}>{labels.contact}</a>
      </nav>
      <a class="language-link" href={languageHref} lang={isEnglish ? 'pt-PT' : 'en'} aria-label={isEnglish ? 'Ver em português' : 'View in English'}>{isEnglish ? 'PT' : 'EN'}</a>
    </div>
  </div>
</header>
