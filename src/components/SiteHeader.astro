---
interface Props { locale: 'pt' | 'en'; active?: string; alternateHref?: string; }
const { locale, active = '', alternateHref } = Astro.props;
const isEnglish = locale === 'en';
const labels = isEnglish
  ? { home: 'Home', projects: 'Projects', about: 'About', contact: 'Contact' }
  : { home: 'Início', projects: 'Projectos', about: 'Sobre', contact: 'Contacto' };
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const route = (path = '') => `${base}${isEnglish ? 'en/' : ''}${path ? `${path}/` : ''}`;
const languageHref = alternateHref ?? (isEnglish ? `${base}${active ? `${active}/` : ''}` : `${base}en/${active ? `${active}/` : ''}`);
---
<a class="skip-link" href="#main">{isEnglish ? 'Skip to content' : 'Saltar para o conteúdo'}</a>
<header class="site-header">
  <div class="container header-inner">
    <a class:list={['wordmark', active === '' && 'wordmark-home']} href={route()}><img class="wordmark-logo" src={`${base}images/brand/navbar-logo.png`} alt="" width="256" height="256" decoding="async" />{active === '' ? <><span class="wordmark-name">Tiago Santos</span><span class="wordmark-label">Portfolio</span></> : 'Tiago Santos · Portfolio'}</a>
    <div class="nav-wrap">
      <nav class="primary-nav" aria-label={isEnglish ? 'Main navigation' : 'Navegação principal'}>
        <a href={route()} aria-current={active === '' ? 'page' : undefined}>{labels.home}</a>
        <a href={route('projects')} aria-current={active === 'projects' ? 'page' : undefined}>{labels.projects}</a>
        <a href={route('about')} aria-current={active === 'about' ? 'page' : undefined}>{labels.about}</a>
        <a href={route('contact')} aria-current={active === 'contact' ? 'page' : undefined}>{labels.contact}</a>
      </nav>
      <a class="language-link" href={languageHref} lang={isEnglish ? 'pt-PT' : 'en'} aria-label={isEnglish ? 'Ver em português' : 'View in English'}>{isEnglish ? 'PT' : 'EN'}</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label={isEnglish ? 'Switch to light theme' : 'Mudar para tema claro'} title={isEnglish ? 'Change colour theme' : 'Alterar tema de cores'}><span class="theme-icon" aria-hidden="true">◐</span></button>
    </div>
  </div>
</header>
<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.querySelector('[data-theme-toggle]');
    let preference = null;
    try { preference = localStorage.getItem('portfolio-theme'); } catch { /* Storage may be unavailable. */ }
    const applyTheme = (theme) => {
      root.dataset.theme = theme;
      if (button) {
        const english = root.lang === 'en';
        button.setAttribute('aria-label', theme === 'dark' ? (english ? 'Switch to light theme' : 'Mudar para tema claro') : (english ? 'Switch to dark theme' : 'Mudar para tema escuro'));
        button.title = english ? 'Change colour theme' : 'Alterar tema de cores';
        button.querySelector('.theme-icon').textContent = theme === 'dark' ? '☼' : '◐';
      }
    };
    applyTheme(root.dataset.theme || (preference === 'light' || preference === 'dark' ? preference : 'dark'));
    button?.addEventListener('click', () => {
      const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem('portfolio-theme', nextTheme); } catch { /* Theme still applies for this page. */ }
      applyTheme(nextTheme);
    });
  })();
</script>
