---
const { locale } = Astro.props;
const isEnglish = locale === 'en';
---
<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {new Date().getFullYear()} Tiago</p>
    <p class="footer-note">{isEnglish ? 'A portfolio in progress.' : 'Um portfolio em construção.'}</p>
  </div>
</footer>
