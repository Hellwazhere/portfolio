---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/case-study.css';
interface Props { project: CollectionEntry<'projects'>; alternateHref?: string; }
const { project, alternateHref } = Astro.props;
const { Content, headings } = await render(project);
const { locale, title, description, kind, tags, images, demoUrl, sourceUrl } = project.data;
const artistWebsite = project.data.translationKey === 'pedro-pires';
const english = locale === 'en';
const uniformScreenshots = ['marketing-dashboard', 'content-assistant', 'myjobs'].includes(project.data.translationKey ?? '');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const projectsHref = `${base}${english ? 'en/' : ''}projects/`;
const sections = headings.filter((heading) => heading.depth === 2);
const captureIntro = artistWebsite
  ? (english ? 'Real captures of the published website in Portuguese. Illustrations by Pedro Pires. Open each image at full size.' : 'Capturas reais do website publicado em português. Ilustrações de Pedro Pires. Abra cada imagem no tamanho original.')
  : project.data.translationKey === 'business-website'
  ? (english ? 'Real captures of the published demonstration in Portuguese. Open each image at full size.' : 'Capturas reais da demonstração publicada em português. Abra cada imagem no tamanho original.')
  : title === 'Smart Clinic Assistant'
  ? (english ? 'Real captures of the public demonstration in Portuguese, using fictional identities and preset messages. Open each image to inspect it at full size.' : 'Capturas reais da demonstração pública em português, com identidades fictícias e mensagens predefinidas. Abra cada imagem para a consultar no tamanho original.')
  : (english ? 'Real captures of the public demonstration in Portuguese, using demonstration data. Open each image to inspect it at full size.' : 'Capturas reais da demonstração pública em português, com dados de demonstração. Abra cada imagem para a consultar no tamanho original.');
---
<BaseLayout locale={locale} active="projects" alternateHref={alternateHref} title={`${title} · ${english ? 'Case study' : 'Estudo de caso'}`} description={description}>
  <article class:list={['case-study', artistWebsite && 'case-study-pedro']}>
    <header class="container case-study-header">
      <a class="text-link case-study-back" href={projectsHref}><span aria-hidden="true">←</span> {english ? 'All projects' : 'Todos os projectos'}</a>
      <p class="eyebrow">{english ? 'Project / Case study' : 'Projecto / Estudo de caso'}</p>
      <h1>{title}</h1>
      <p class="page-intro">{description}</p>
      {(demoUrl || sourceUrl) && <div class="hero-actions">
        {demoUrl && <a class="button" href={demoUrl} target="_blank" rel="noopener noreferrer" aria-label={artistWebsite ? (english ? 'Visit website (opens in a new tab)' : 'Visitar website (abre num novo separador)') : (english ? 'Live demo (opens in a new tab)' : 'Ver demonstração (abre num novo separador)')}>{artistWebsite ? (english ? 'Visit website' : 'Visitar website') : (english ? 'Live demo' : 'Ver demonstração')} <span aria-hidden="true">↗</span></a>}
        {sourceUrl && <a class="button button-secondary" href={sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={english ? 'View source (opens in a new tab)' : 'Ver código (abre num novo separador)'}>{english ? 'View source' : 'Ver código'} <span aria-hidden="true">↗</span></a>}
      </div>}
      <dl class="case-study-facts">
        <div><dt>{english ? 'Status' : 'Estado'}</dt><dd>{kind}</dd></div>
        <div><dt>{english ? 'Evidence' : 'Material de apoio'}</dt><dd>{english ? 'Inspected code, documentation and captures' : 'Código inspeccionado, documentação e capturas'}</dd></div>
        <div><dt>{english ? 'Technologies' : 'Tecnologias'}</dt><dd><div class="tag-list">{tags.map((tag) => <span class="tag">{tag}</span>)}</div></dd></div>
      </dl>
    </header>
    <div class="container case-study-layout">
      <nav class="case-study-index" aria-label={english ? 'In this case study' : 'Neste estudo de caso'}>
        <p class="eyebrow">{english ? 'In this case study' : 'Neste estudo de caso'}</p>
        <ol>{sections.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
          {images?.length && <li><a href="#screenshots">{english ? 'Interface in context' : 'Interface em contexto'}</a></li>}
        </ol>
      </nav>
      <div class="case-study-main">
        <div class="case-study-prose"><Content /></div>
        {images?.length && <section class="case-study-gallery" aria-labelledby="screenshots">
          <p class="eyebrow">{english ? 'Visual walkthrough' : 'Percurso visual'}</p>
          <h2 id="screenshots">{english ? 'Interface in context' : 'Interface em contexto'}</h2>
          <p>{captureIntro}</p>
          {uniformScreenshots && <p>{english ? 'Scroll within each preview to see the complete interface, or open the image at full size.' : 'Desloque cada pré-visualização para consultar a interface completa, ou abra a imagem no tamanho original.'}</p>}
          {images.map((image, index) => <figure>
            <div class={uniformScreenshots ? 'screenshot-viewport' : undefined} tabindex={uniformScreenshots ? 0 : undefined} role={uniformScreenshots ? 'region' : undefined} aria-label={uniformScreenshots ? `${english ? 'Scrollable capture' : 'Captura com deslocamento'}: ${image.alt}` : undefined}>
            <a href={`${base}${image.src.replace(/^\/+/, '')}`} target="_blank" rel="noopener noreferrer" aria-label={`${english ? 'Open image' : 'Abrir imagem'}: ${image.alt}`}>
              <img src={`${base}${image.src.replace(/^\/+/, '')}`} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
            </a>
            </div>
            <figcaption><span class="project-index">{String(index + 1).padStart(2, '0')}</span> {image.alt}</figcaption>
          </figure>)}
        </section>}
      </div>
    </div>
    <footer class="container case-study-footer">
      <p>{english ? 'Explore the other projects and case studies.' : 'Explore os restantes projectos e estudos de caso.'}</p>
      <a class="text-link" href={projectsHref}><span aria-hidden="true">←</span> {english ? 'Back to projects' : 'Regressar aos projectos'}</a>
    </footer>
  </article>
</BaseLayout>
